@prefix psm: <http://data.ashrae.org/standard223/1.0/data/pd-sr-mp-pritoni#> .
@prefix cyber: <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .
@prefix : <http://www.semanticweb.org/snm49/ontologies/2026/5/integration/> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix s223: <http://data.ashrae.org/standard223#> .  
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


:EventLogShape rdf:type owl:NamedIndividual, sh:NodeShape ;
              sh:property [ 
                sh:path cyber:recordsEvent ;
                sh:class cyber:Event ; 
                sh:minCount 1 ;
              ] ;
              sh:property [ 
                sh:path cyber:generatedBy ;
                sh:class cyber:Asset ; 
                sh:minCount 1;
              ] ;
              sh:targetClass d3f:EventLog .



###  http://data.ashrae.org/standard223#FunctionShape
:FunctionShape rdf:type owl:NamedIndividual ,
                            sh:NodeShape ;
                   sh:property [ sh:class   s223:Property ;
                                 sh:path cyber:modifies
                               ] ;
                   sh:targetClass s223:Function .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/AuthenticationServiceShape
:AuthenticationServiceShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                           sh:property [ 
                                          sh:path d3f:authenticates ;
                                          sh:or (
                                              [ sh:class d3f:User ]
                                              [ sh:class d3f:Host ]
                                          ) ;
                                        ] ;
                            sh:property [ sh:class d3f:Credential ;
                                          sh:path cyber:validates;
                                          sh:minCount 1 ;
                                        ] ;
                            sh:property [
                              sh:path [ sh:inversePath cyber:hosts ] ;
                              sh:minCount 1 ;      
                                        ] ; 
                            sh:targetClass d3f:AuthenticationService .

:AuthenticationServerShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:property [ sh:class d3f:AuthenticationService ;
                                          sh:path d3f:manages 
                                        ] ;
                            sh:property [ sh:class cyber:Asset ;
                                          sh:path cyber:protects 
                                        ] ;
                            sh:targetClass d3f:AuthenticationServer .



:EnforcementPointShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                        sh:property [ sh:class s223:Property ;
                                      sh:path s223:hasProperty 
                                    ] ;
                        sh:property [ sh:path cyber:controlsAccessTo ;
                                      sh:class s223:Equipment 
                                    ] ;
                        sh:property [ sh:path cyber:protects ;
                                      sh:class cyber:Asset 
                                    ] ;
                        sh:targetClass cyber:EnforcementPoint .         

:AssetShape rdf:type owl:NamedIndividual, sh:NodeShape ;
  sh:property [ sh:class s223:PhysicalSpace ;
                sh:path s223:hasPhysicalLocation 
              ] ;
            sh:targetClass cyber:Asset .            




###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/UserShape
:UserShape 
rdf:type owl:NamedIndividual ,
        sh:NodeShape ;
           
        sh:property [
          sh:class cyber:Asset ;
          sh:path cyber:requestsAccessTo ;
        ] ;
        sh:property [ 
          sh:class d3f:Credential ;
          sh:path cyber:hasCredential ;
          sh:minCount 1 ;
        ] ;

        sh:property [sh:class cyber:Device ;
          sh:path cyber:usesDevice ;
        ] ;
          
        sh:property [
          sh:path cyber:hasRole ;
          sh:minCount 1 ;
          ] ;
           sh:targetClass d3f:User .


:FirewallShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
               sh:property [sh:class d3f:NetworkTraffic ;
                             sh:path d3f:filters
                           ] ;
               sh:targetClass d3f:Firewall .

:DeviceShape rdf:type owl:NamedIndividual ,
                      sh:NodeShape ;
              sh:property [sh:class cyber:NetworkSegment ;
                            sh:path s223:cnx ;
                            sh:minCount 1 ;
                            ] ;
              sh:targetClass cyber:Device .

:OperatorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
                sh:property [
                  sh:path cyber:hasPermission ; 
                  sh:in (
                    cyber:ModifySetPoints 
                    cyber:ControlAlarms 
                    cyber:MonitorBuildingServer 
                    cyber:ViewSensorData 
                    cyber:ModifyAccountDetails 
                  ) ;
                ] ;

                sh:targetClass cyber:Operator .

:EmergencyResponderShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;

                  sh:property [

                  sh:path cyber:hasPermission ; 
                  sh:in (
                    cyber:OverrideDoorLocks 
                    cyber:ControlAlarms 
                    cyber:EmergencyOverride 
                    cyber:ViewSensorData 
                    cyber:ViewCameraFeeds 
                  ) ;
                ] ;
                sh:targetClass cyber:EmergencyResponder .


:VendorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;

                  sh:property [
                 
                  sh:path cyber:hasPermission ; 
                  sh:in (
                    cyber:ViewCameraFeeds 
                    cyber:ConfigureControllers 
                    cyber:ViewSensorData
                    cyber:ApplySoftwareUpdates 
                    cyber:ViewLogs 
                  ) ;
                ] ;

                sh:targetClass cyber:Vendor . 