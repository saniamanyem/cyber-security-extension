@prefix psm: <http://data.ashrae.org/standard223/1.0/data/pd-sr-mp-pritoni#> .
@prefix cyber: <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix s223: <http://data.ashrae.org/standard223#> .  
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<http://www.semanticweb.org/snm49/ontologies/2026/5/integration> a owl:Ontology ;
                                                                owl:imports <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> ,
                                                                <http://data.ashrae.org/standard223/1.0/data/pd-sr-mp-pritoni> ,
                                                                <http://d3fend.mitre.org/ontologies/d3fend/1.4.0/d3fend.owl> ,
                                                                <http://data.ashrae.org/standard223/1.0/model/all> .


### graphdb doesnt reason over subclass relationships

psm:HVACZone1Thermostat 
    a cyber:Asset .

psm:VAVBox1DamperActuator 
    a cyber:Asset .

psm:HVACZone1TemperatureSetpoint 
    a s223:Property  .

:EnterpriseNetwork 
    a cyber:NetworkSegment .

:DMZNetwork 
    a cyber:NetworkSegment .

:ControlNetwork 
    a cyber:NetworkSegment .

:Sandy
    a d3f:User ;
    cyber:hasRole cyber:Operator ; 
    cyber:hasCredential cyber:SandyPassword123 ; 
    cyber:requestsAccessTo psm:HVACZone1Thermostat ;
    cyber:usesDevice cyber:OperatorWorkstation .

:SandyPassword123 
    a d3f:Credential .

:ModifySetpoints 
    cyber:appliesTo psm:HVACZone1TemperatureSetpoint .

:ViewSensorData 
    cyber:appliesTo psm:HVACZone1TemperatureSensor .

:MonitorBuildingServer 
    cyber:appliesTo cyber:BuildingServer .

:ControlAlarms 
    cyber:appliesTo cyber:FireAlarmPanel .

:ModifyAccountDetails 
    cyber:appliesTo cyber:BuildingAuthenticationServer .

:OperatorWorkstation  
  a cyber:Device , cyber:Asset ;
    s223:cnx cyber:EnterpriseNetwork .

:VendorLaptop 
  a cyber:Device, cyber:Asset ;
  s223:cnx cyber:DMZNetwork .

:EmergencyMonitor 
  a cyber:Device, cyber:Asset ;
  s223:cnx cyber:EnterpriseNetwork .        

:BuildingAuthenticationServer 
  a d3f:AuthenticationServer, cyber:Asset ;
    cyber:hosts cyber:BuildingAuthenticationService ;
    cyber:protects 
        psm:VAVBox1DamperActuator ,
        cyber:FireAlarmPanel ,
        cyber:BuildingServer ,
        psm:HVACZone1Thermostat .

:BuildingAuthenticationService 
    a d3f:AuthenticationService ;
    cyber:validates 
        cyber:SandyPassword123 ;
    d3f:authenticates 
        cyber:Sandy ;
    cyber:enforcedBy cyber:AccessGateway .

:AccessGateway 
    a cyber:EnforcementPoint ; 
    cyber:protects
        psm:VAVBox1DamperActuator ,
        psm:HVACZone1Thermostat ,
        cyber:FireAlarmPanel ;
    s223:hasProperty psm:HVACZone1TemperatureSetpoint .

:ModifySetpointEvent
    a cyber:Event .

:BuildingAuditLog 
    a cyber:AuditLog ;
    cyber:recordsEvent cyber:ModifySetpointEvent ;
    cyber:generatedBy psm:HVACZone1Thermostat .

:BuildingServer 
    a d3f:Database .

:FireAlarmPanel 
    a s223:Equipment .

:MainDoorLocks
    a s223:Equipment .