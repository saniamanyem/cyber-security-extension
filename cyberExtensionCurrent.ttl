@prefix cyber: <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@base <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .

<http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> rdf:type owl:Ontology ;
                                                                     owl:imports <http://d3fend.mitre.org/ontologies/d3fend/1.4.0/d3fend.owl> ,
                                                                                 <http://data.ashrae.org/standard223/1.0/model/all> .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/ns/shacl#class
sh:class rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#path
sh:path rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#property
sh:property rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetClass
sh:targetClass rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################


d3f:AuthenticationServer rdfs:subclassOf cyber:Asset ;
:hosts d3f:AuthenticationService ;
rdfs:label "d3f:AuthenticationServer" .

d3f:AuthenticationService rdfs:subclassOf d3f:Action ;
rdfs:label "d3f:AuthenticationService" ;
:validates d3f:Credential .


###  http://d3fend.mitre.org/ontologies/d3fend.owl#Database
d3f:Database rdfs:subClassOf cyber:Asset ;
rdfs:label "d3f:Database" .

###  http://data.ashrae.org/standard223#Equipment
s223:Equipment rdfs:subClassOf cyber:Asset ;
rdfs:label "s223:Equipment" .

:role rdf:type owl:Class ;
rdfs:label ":role" . 


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/Asset
cyber:Asset rdf:type owl:Class ;
rdfs:label ":Asset" .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/Condition
cyber:Condition rdf:type owl:Class ;
rdfs:label ":Condition" .

cyber:EmergencyCondition rdf:type cyber:Condition ; 
  rdfs:label ":EmergencyCondition" . 

cyber:MaintenanceWindow rdf:type cyber:Condition ;
  rdfs:label ":MaintenanceWindow" . 

cyber:NormalOperations rdf:type cyber:Condition ;
  rdfs:label ":NormalOperations" .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/EnforcementPoint
cyber:EnforcementPoint rdf:type owl:Class ;
rdfs:subclassOf cyber:Asset ;
rdfs:label ":EnforcementPoint " .

cyber:AuditLog rdf:type owl:Class ;
rdfs:subclassOf cyber:Asset ;
rdfs:label ":AuditLog" .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/Permission
cyber:Permission rdf:type s223:EnumerationKind ;
rdfs:label ":Permission" .

:OverrideDoorLocks rdf:type cyber:Permission ;
  rdfs:label ":OverrideDoorLocks " ;
  :allowsAction cyber:control ;
  :validDuring cyber:EmergencyCondition .

cyber:ViewCameraFeeds rdf:type cyber:Permission ;
  :allowsAction cyber:read ;
  rdfs:label ":ViewCameraFeeds " .

cyber:ModifySetPoints rdf:type cyber:Permission ;
  :allowsAction cyber:write ;
  rdfs:label ":ModifySetPoints " .

cyber:ControlAlarms rdf:type cyber:Permission ;
  :allowsAction cyber:control ;
  rdfs:label ":ControlAlarms " .

cyber:ConfigureControllers rdf:type cyber:Permission ;
  :allowsAction cyber:write ;
  rdfs:label ":ConfigureControllers " .

cyber:MonitorBuildingServer rdf:type cyber:Permission ;
  :allowsAction cyber:View ;
  rdfs:label ":MonitorBuildingServer " .

cyber:ViewSensorData rdf:type cyber:Permission ;
  :allowsAction cyber:read ;
  rdfs:label ":ViewSensorData " .

cyber:ApplySoftwareUpdates rdf:type cyber:Permission ;
  :allowsAction cyber:write ;
  rdfs:label "cyber:ApplySoftwareUpdates " .

cyber:ModifyAccountDetails rdf:type cyber:Permission ;
  :allowsAction cyber:control ;
  rdfs:label "cyber:ModifyAccountDetails " .

cyber:EmergencyOverride rdf:type cyber:Permission ;
  rdfs:label "cyber:EmergencyOverride " ;
  :allowsAction cyber:control ;
  :validDuring cyber:EmergencyCondition .

cyber:ViewLogs rdf:type cyber:Permission ;
  :allowsAction cyber:read ;
  rdfs:label "cyber:ViewLogs " .

cyber:read rdf:type d3f:Action ; 
  rdfs:label "cyber:read " .

cyber:write rdf:type d3f:Action ; 
  rdfs:label "cyber:write " .

cyber:control rdf:type d3f:Action ; 
  rdfs:label "cyber:control " .

cyber:EmergencyResponder rdf:type cyber:role ;
  rdfs:subClassOf d3f:User ;
  rdfs:label ":EmergencyResponder" ;
  cyber:hasPermission 
       cyber:OverrideDoorLocks ,
       cyber:ControlAlarms ,
       cyber:EmergencyOverride ,
       cyber:ViewSensorData ,
       cyber:ViewCameraFeeds .

cyber:Vendor rdf:type cyber:role ;
  rdfs:subClassOf d3f:User ;
  rdfs:label ":Vendor" ;
  cyber:hasPermission
    cyber:ViewCameraFeeds ,
    cyber:ConfigureControllers ,
    cyber:ViewSensorData ,
    cyber:ApplySoftwareUpdates ,
    cyber:ViewLogs .

cyber:Operator rdf:type cyber:role ;
  rdfs:subClassOf d3f:User ;
  rdfs:label ":Operator" ;
  cyber:hasPermission 
    cyber:ModifySetPoints ,
    cyber:ControlAlarms ,
    cyber:MonitorBuildingServer ,
    cyber:ViewSensorData ,
    cyber:ModifyAccountDetails .



cyber:NetworkSegment rdf:type owl:Class ;
                rdfs:subClassOf d3f:Network ;
                rdfs:label ":NetworkSegment" .

cyber:Device rdf:type owl:Class ;
        rdfs:subclassOf s223:Equipment ;
        rdfs:label ":Device" .


cyber:Event rdf:type owl:Class ; 
rdfs:label ":Event" . 

cyber:ControlNetwork rdf:type cyber:NetworkSegment ;
rdfs:label ":ControlNetwork" .

cyber:RemoteAccessNetwork rdf:type cyber:NetworkSegment , d3f:Network ;
rdfs:label "RemoteAccessNetwork" .

cyber:DMZNetwork rdf:type cyber:NetworkSegment ;
rdfs:label ":DMZNetwork" .

cyber:EnterpriseNetwork rdf:type cyber:NetworkSegment ;
rdfs:label ":EnterpriseNetwork" .

#################################################################
#    Individuals
#################################################################

cyber:hasRole rdf:type owl:NamedIndividual, s223:Relation ;
        rdfs:domain d3f:User ;
        rdfs:range cyber:role ;
        rdfs:label ":hasRole" .

cyber:grantedPermission rdf:type owl:NamedIndividual, s223:Relation ; 
                  rdfs:domain cyber:role ;
                  rdfs:range cyber:Permission ;
                  rdfs:label ":grantedPermission" .
  
cyber:hosts rdf:type owl:NamedIndividual , s223:Relation ;
       rdfs:domain d3f:AuthenticationServer ;
       rdfs:range d3f:AuthenticationService ; 
       rdfs:label ":hosts" . 

cyber:requestedBy rdf:type owl:NamedIndividual, s223:Relation ;
  rdfs:label ":requestedBy" ;
  rdfs:domain cyber:Permission ; 
  rdfs:range d3f:User . 

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/affectedBy
cyber:affectedBy rdf:type owl:NamedIndividual ,
                     s223:Relation ;
            rdfs:comment "A Permission is affected by a Condition" ;
            rdfs:label ":affectedBy" ;
            rdfs:domain cyber:Asset ; 
            rdfs:range cyber:Event .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/allowsAction
cyber:allowsAction rdf:type owl:NamedIndividual ,
                       s223:Relation ;
              rdfs:label ":allowsAction" ;
              rdfs:domain cyber:Permission ;
              rdfs:range d3f:Action . 

cyber:recordsEvent rdf:type owl:NamedIndividual, s223:Relation ;
              rdfs:label ":recordsEvent" ;
              rdfs:domain cyber:AuditLog ; 
              rdfs:range cyber:Event .

cyber:generatedBy rdf:type owl:NamedIndividual, s223:Relation ;
             rdfs:label ":generatedBy" ;
             rdfs:domain cyber:AuditLog ; 
             rdfs:range cyber:Asset .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/appliesTo
cyber:appliesTo rdf:type owl:NamedIndividual ,
                    s223:Relation ;
                    rdfs:label ":appliesTo" ;
                    rdfs:domain cyber:Permission ; 
                    rdfs:range cyber:Asset .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/enforcedBy
cyber:enforcedBy rdf:type owl:NamedIndividual ,
                     s223:Relation ;
            rdfs:comment "A Permission is enforced by an Enforcement Point" ;
            rdfs:label "enforcedBy" ;
            rdfs:domain d3f:AuthenticationService ;
            rdfs:range cyber:EnforcementPoint .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/hasCredential
cyber:hasCredential rdf:type owl:NamedIndividual ,
                        s223:Relation ;
               rdfs:domain d3f:User ;
               rdfs:range d3f:Credential ;
               rdfs:comment "A User has credential Credential" ;
               rdfs:label ":hasCredential" .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/modifies
cyber:modifies rdf:type owl:NamedIndividual ,
                   s223:Relation ;
                   rdfs:label ":modifies" ;
                   rdfs:domain d3f:Action ;
                   rdfs:range cyber:Asset .

cyber:protects rdf:type owl:NamedIndividual ,
                   s223:Relation ;
          rdfs:label ":protects" ;
          rdfs:domain cyber:EnforcementPoint ;
          rdfs:range cyber:Asset .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/requestsAccessTo
cyber:requestsAccessTo rdf:type owl:NamedIndividual ,
                           s223:Relation ;
                  rdfs:domain d3f:User ;
                  rdfs:range cyber:Asset ;
                  rdfs:comment "A User requests access to an Asset" ;
                  rdfs:label ":requestsAccessTo" .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/validDuring
cyber:validDuring rdf:type owl:NamedIndividual ,
                      s223:Relation ;
             rdfs:comment "A Permission is valid during a Condition" ;
             rdfs:label ":validDuring" ;
             rdfs:domain cyber:Permission ; 
             rdfs:range cyber:Condition .


cyber:validates rdf:type owl:NamedIndividual ,
                   s223:Relation ;
                   rdfs:label ":validates" ;
                   rdfs:domain d3f:AuthenticationService ;
                   rdfs:range cyber:Credential .





              
cyber:usesDevice rdf:type owl:NamedIndividual ,
                      s223:Relation ;
              rdfs:comment "A User uses a Device" ;
              rdfs:label ":usesDevice" ;
              rdfs:domain d3f:User ;
              rdfs:range cyber:Device .
            

d3f:User rdfs:label "d3f:User" .
d3f:Credential rdfs:label "d3f:Credential" .
d3f:Database rdfs:label "d3f:Database" .
d3f:AuthenticationService rdfs:label "d3f:AuthenticationService" .
d3f:Network rdfs:label "d3f:Network" .
d3f:Action rdfs:label "d3f:Action" .

s223:cnx rdfs:label "s223:cnx" .
s223:controller rdfs:label "s223:controller" .
s223:Sensor rdfs:label "s223:Sensor" .
s223:Actuator rdfs:label "s223:Actuator" .


:AuditLogShape rdf:type owl:NamedIndividual, sh:NodeShape ;
              sh:property [ 
                sh:path cyber:recordsEvent ;
                sh:class cyber:Event ; 
                sh:minCount 1 ;
              ] ;
              sh:property [ 
                sh:path cyber:generatedBy ;
                sh:class cyber:Asset ; 
                sh:minCount 1;
              ] ;
              sh:targetClass cyber:AuditLog .



###  http://data.ashrae.org/standard223#FunctionShape
:FunctionShape rdf:type owl:NamedIndividual ,
                            sh:NodeShape ;
                   sh:property [ sh:class   s223:Property ;
                                 sh:path cyber:modifies
                               ] ;
                   sh:targetClass s223:Function .

###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/AssetShape
:AssetShape rdf:type owl:NamedIndividual ,
                     sh:NodeShape ;
            sh:property [ sh:class d3f:Network ;
                          sh:path s223:cnx 
                        ] ; 
            sh:targetClass cyber:Asset .


###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/AuthenticationServiceShape
:AuthenticationServiceShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:property [ sh:class d3f:User ;
                                        sh:path d3f:authenticates ;
                                        sh:minCount 1 ;
                                        ] ;
                            sh:property [ sh:class d3f:Credential ;
                                          sh:path cyber:validates;
                                          sh:minCount 1 ;
                                        ] ;
                            sh:property [
                              sh:path [sh:inversePath cyber:hosts ] ;
                              sh:minCount 1 ;      
                                        ] ; 
                            sh:targetClass d3f:AuthenticationService .

:AuthenticationServerShape rdf:type owl:NamedIndividual ,
                                     sh:NodeShape ;
                            sh:property [ sh:class d3f:AuthenticationService ;
                                          sh:path cyber:hosts 
                                        ] ;
                            sh:property [ sh:class cyber:Asset ;
                                          sh:path cyber:protects 
                                        ] ;
                            sh:targetClass d3f:AuthenticationServer .



:EnforcementPointShape rdf:type owl:NamedIndividual ,
                                sh:NodeShape ;
                        sh:property [ sh:class s223:Property ;
                                      sh:path s223:hasProperty 
                                    ] ;
                        sh:property [ sh:path cyber:protects ;
                                      sh:minCount 1 ;
                                      sh:class cyber:Asset ;
                                    ] ;
                        sh:targetClass cyber:EnforcementPoint .         




###  http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/UserShape
:UserShape 
rdf:type owl:NamedIndividual ,
        sh:NodeShape ;
           
        sh:property [
          sh:class cyber:Asset ;
          sh:path cyber:requestsAccessTo ;
        ] ;
        sh:property [ 
          sh:class d3f:Credential ;
          sh:path cyber:hasCredential ;
          sh:minCount 1 ;
        ] ;

        sh:property [sh:class cyber:Device ;
          sh:path cyber:usesDevice ;
        ] ;
          
        sh:property [
          sh:path cyber:hasRole ;
          sh:minCount 1 ;
          ] ;

        sh:sparql [
          sh:message "Vendor users must use a Device connected to DMZ Network" ;

          sh:select """
          PREFIX cyber: <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/>
          PREFIX s223: <http://data.ashrae.org/standard223#>


          SELECT $this 
          WHERE {
            $this <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/hasRole>
            <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/Vendor> .

            FILTER NOT EXISTS {
              $this <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/usesDevice> ?Device .
              ?Device <http://data.ashrae.org/standard223#cnx>
               <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/DMZNetwork> .
            }
          }

          """ ;
        ] ;
           sh:targetClass d3f:User .


:FirewallShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
               sh:property [sh:class d3f:NetworkTraffic ;
                             sh:path d3f:filters
                           ] ;
               sh:targetClass d3f:Firewall .

:SensorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
               sh:property [sh:hasValue cyber:ControlNetwork ;
                             sh:path s223:cnx ;
                           ] ;
               sh:targetClass s223:Sensor .

:ControllerShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
               sh:property [sh:hasValue cyber:ControlNetwork ;
                             sh:path s223:cnx ;
                           ] ;
               sh:targetClass s223:controller .

:ActuatorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
               sh:property [sh:hasValue cyber:ControlNetwork ;
                             sh:path s223:cnx ;
                           ] ;
               sh:targetClass s223:Actuator .

:DeviceShape rdf:type owl:NamedIndividual ,
                      sh:NodeShape ;
              sh:property [sh:class cyber:NetworkSegment ;
                            sh:path s223:cnx ;
                            sh:minCount 1 ;
                            ] ;
              sh:targetClass cyber:Device .

:OperatorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;
                sh:property [
                  sh:path cyber:grantedPermission ; 
                  sh:in (
                    cyber:ModifySetPoints 
                    cyber:ControlAlarms 
                    cyber:MonitorBuildingServer 
                    cyber:ViewSensorData 
                    cyber:ModifyAccountDetails 
                  ) ;
                ] ;

                sh:targetNode cyber:Operator .

#MUST HAVE ALL OF THESE...note in documentation

:EmergencyResponderShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;

                  sh:property [

                  sh:path cyber:grantedPermission ; 
                  sh:in (
                    cyber:OverrideDoorLocks 
                    cyber:ControlAlarms 
                    cyber:EmergencyOverride 
                    cyber:ViewSensorData 
                    cyber:ViewCameraFeeds 
                  ) ;
                ] ;
                sh:targetNode cyber:EmergencyResponder .


:VendorShape rdf:type owl:NamedIndividual ,
                        sh:NodeShape ;

                  sh:property [
                 
                  sh:path cyber:grantedPermission ; 
                  sh:in (
                    cyber:ViewCameraFeeds 
                    cyber:ConfigureControllers 
                    cyber:ViewSensorData
                    cyber:ApplySoftwareUpdates 
                    cyber:ViewLogs 
                  ) ;
                ] ;

                sh:targetNode cyber:Vendor . 


:CredentialShape rdf:type owl:NamedIndividual, sh:NodeShape ; 
    sh:property [
      sh:path [ sh:inversePath cyber:hasCredential ] ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
    ] ;
    sh:targetClass d3f:Credential .




