@prefix : <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .
@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@base <http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> .

<http://www.semanticweb.org/snm49/ontologies/2026/5/cyberExtension/> rdf:type owl:Ontology ;
                                                                     owl:imports <http://d3fend.mitre.org/ontologies/d3fend/1.4.0/d3fend.owl> ,
                                                                                 <http://data.ashrae.org/standard223/1.0/model/all> .

:Dan
    a d3f:User ;
    cyber:hasRole cyber:Vendor ;
    cyber:usesDevice :VendorLaptop;
    cyber:hasCredential :DanPassword123 ; 
    cyber:requestsAccessTo 
        :Skybox 
        :MaintenanceSystem
    .

:ApplySoftwareUpdates   
     cyber:appliesTo :MaintenanceSystem .

:ViewSensorData 
    cyber:appliesTo :Skybox .

:Skybox 
    a cyber:Asset . 

:MaintenanceSystem 
    a cyber:Asset .

:VendorLaptop
    a cyber:Device ;
    s223:cnx :VendorNetwork .

:VendorNetwork
    a cyber:NetworkSegment .

:DanPassword123 
    a d3f:Credential .

:BuildingAuthenticationServer
    a d3f:AuthenticationServer ;
    cyber:hosts :BuildingAuthenticationService ;
    cyber:protects 
        :Skybox ,
        :MaintenanceSystem .

:BuildingAuthenticationService 
    a d3f:AuthenticationService ;
    cyber:validates :DanPassword123 ;
    d3f:authenticates :Dan ;
    cyber:enforcedBy :BuildingGateway .

:BuildingGateway 
    a cyber:EnforcementPoint .        

:AccessSkyboxDataEvent
    a cyber:Event .

:ApplySoftwareUpdatesEvent
    a cyber:Event .

:BuildingAuditLog 
    cyber:recordsEvent 
        :AccessSkyboxDataEvent ,
        :ApplySoftwareUpdatesEvent .